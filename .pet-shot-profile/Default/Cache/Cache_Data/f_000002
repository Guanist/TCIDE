    // 没有异步 fetch，也就没有"先空一下再出现"的闪烁。
    const labelEl = document.getElementById('label');
    let hideTimer;

    function apply(state, label) {
      const visual = STATE_MAP[state] || 'idle';
      petEl.classList.remove('state-idle', 'state-work', 'state-sleep', 'state-error');
      petEl.classList.add('state-' + visual);
      const text = label || LABELS[state] || '';
      if (text) {
        labelEl.textContent = text;
        labelEl.classList.add('show');
        clearTimeout(hideTimer);
        // 待机时不挂着一句话，让它自己淡出 —— 悬浮宠物不该一直占着文字
        if (visual === 'idle') hideTimer = setTimeout(() => labelEl.classList.remove('show'), 2500);
      }
      petEl.setAttribute('aria-label', '虎猫宠物：' + (text || visual));
    }

    // 轮询状态。用轮询而不是 SSE/WebSocket：宠物只要 1~2 次/秒的粒度，
    // 而轮询在"服务器重启/网络抖动"下自愈，不需要重连逻辑。
    async function poll() {
      try {
        const info = await fetch('/api/pet/state').then((r) => r.json());
        apply(info.state || 'idle', info.label || '');
      } catch { /* 拉不到就保持现状，下次再试 */ }
    }
    poll();
    setInterval(poll, 900);

    // 右键菜单在悬浮宠物上没有意义，屏蔽掉（避免点出浏览器菜单遮住宠物）
    window.addEventListener('contextmenu', (event) => event.preventDefault());
  </script>
</body>
</html>
